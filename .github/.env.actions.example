# Reference only: GitHub Actions does NOT load this file.
# GitHub repo > Settings > Secrets and variables > Actions > Repository secrets.
# All five names must be Secrets: this matches the existing cd.yml checks.
VERCEL_TOKEN=REPLACE_WITH_VERCEL_TOKEN
VERCEL_ORG_ID=REPLACE_WITH_VERCEL_ORG_ID
VERCEL_PROJECT_ID=REPLACE_WITH_VERCEL_PROJECT_ID
RENDER_API_KEY=REPLACE_WITH_RENDER_API_KEY
RENDER_SERVICE_ID=srv-REPLACE_WITH_RENDER_SERVICE_ID

# Optional: add these in the Variables tab, not as Secrets.
# FRONTEND_URL=https://YOUR_PROJECT.vercel.app
# VERCEL_CLI_VERSION=REPLACE_WITH_REVIEWED_EXACT_X_Y_Z_VERSION
# BACKEND_HEALTH_PATH=/api/v1/health
# cd.yml uses the Render API, not a deploy hook; no RENDER_DEPLOY_HOOK_URL needed.
