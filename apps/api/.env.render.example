# Render > Web Service > Environment. Replace placeholders before deploying.
# Runtime: Docker; Root Directory: apps/api; Dockerfile: ./Dockerfile.
# Keep the default Docker command; the image reads Render PORT automatically.
SPRING_PROFILES_ACTIVE=supabase
# Supabase > Connect > Session pooler: copy the actual host and username.
# JDBC URL only; keep credentials separate. TLS and ddl-auto=update already default.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Generate a private random value, e.g. openssl rand -hex 32.
APP_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
APP_CORS_ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app
APP_WEB_ORIGIN=https://YOUR_PROJECT.vercel.app

# Required for registration/password-reset email OTP; otherwise delivery is disabled.
# APP_OTP_DELIVERY=smtp
# SMTP_HOST=YOUR_SMTP_HOST
# SMTP_PORT=587
# SMTP_USERNAME=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# SMTP_FROM=YOUR_VERIFIED_SENDER_EMAIL

# Optional first admin on an empty database; remove after successful creation.
# APP_BOOTSTRAP_ADMIN_EMAIL=YOUR_ADMIN_EMAIL
# APP_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PRIVATE_PASSWORD
